# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.venv-worker/
.tmp/
# Stale nested copy of this same project; kept out of the repo so a clone does
# not get a phantom submodule. Safe to delete locally.
src/components/mood-checker/

__pycache__/
*.pyc

# Worker runtime output: live previews, face crops and rejected-face snapshots.
public/_worker-live/
public/_worker-snaps/
public/_faces/
public/_phantom-rejects/

# Emotion ONNX model (~16 MB) — fetch with scripts/download-emotion-model.mjs
worker/models/

worker/recognition-queue.jsonl
worker/recognition-queue.cursor
worker/recognition-queue.cursor.tmp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.worker.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env
.env.*
!.env.example
!.env.worker.example
dev.db
dev.db-journal
*.db
*.db-journal
