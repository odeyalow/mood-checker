# Node detection worker env (InsightFace backend + worker status UI)

# Cameras in format: cameraId=go2rtc_src
# Example: cam-01=cam01_main
# If empty, worker falls back to NEXT_PUBLIC_CAMERA_1_GO2RTC_SRC..4 from .env.
WORKER_CAMERA_SOURCES=cam-01=cam01_main

# Frame API (direct go2rtc source used by both UI and worker)
# Optional quality params can be passed in URL:
# http://127.0.0.1:1984/api/frame.jpeg?width=960&height=540&quality=82
WORKER_FRAME_API_BASE=http://127.0.0.1:1984/api/frame.jpeg?width=960&height=540&quality=82
WORKER_FRAME_TIMEOUT_MS=1200
# Retry once with lighter frame settings when frame request hits AbortError timeout
WORKER_FRAME_ABORT_RETRY_ENABLED=true
WORKER_FRAME_ABORT_RETRY_TIMEOUT_MS=2500
WORKER_IMAGE_DECODE_TIMEOUT_MS=1500
WORKER_CAMERA_PROCESS_TIMEOUT_MS=7000
WORKER_FRAME_ABORT_RETRY_WIDTH=1280
WORKER_FRAME_ABORT_RETRY_HEIGHT=720
WORKER_FRAME_ABORT_RETRY_QUALITY=85
# Cameras processing parallelism (1..N cameras)
WORKER_PARALLEL_CAMERAS=1
WORKER_LOOP_DELAY_MS=50

# Logging/status cadence
WORKER_HEARTBEAT_SECONDS=5
WORKER_STATUS_LOG_SECONDS=1.5
WORKER_STATUS_FILE=/tmp/mood-checker-worker-status.json
WORKER_ZOOM_STATE_FILE=/tmp/mood-checker-worker-zoom.json
WORKER_ZOOM_RELOAD_MS=700
# Per-camera worker zoom defaults (x1..x5), optional.
# If empty, worker inherits NEXT_PUBLIC_CAMERA_1_DIGITAL_ZOOM..4 from .env.
# Example: cam-01=2
WORKER_CAMERA_ZOOMS=
# Optional per-camera thresholds as JSON.
# Example:
# {"cam-01":{"matchThreshold":0.5,"emotionMinConfidence":0.5,"frameOffsetY":0.18}}
WORKER_CAMERA_SETTINGS_JSON=
WORKER_DETECTION_LOG_COOLDOWN_MS=500
WORKER_CANDIDATE_LOG_COOLDOWN_MS=700

# Detection options (fast-pass defaults)
WORKER_INFERENCE_BACKEND=auto
WORKER_INFERENCE_FALLBACK_FACEAPI=true
WORKER_INSIGHTFACE_ENDPOINT=http://127.0.0.1:8765
WORKER_INSIGHTFACE_PORT=8765
WORKER_INSIGHTFACE_TIMEOUT_MS=2500
WORKER_INSIGHTFACE_STARTUP_TIMEOUT_MS=30000
WORKER_INSIGHTFACE_MODEL=buffalo_l
# Optional explicit python binary. If empty, worker tries local .venv first, then python/python3 from PATH.
WORKER_PYTHON_BIN=
WORKER_TINY_INPUT_SIZE=512
WORKER_TINY_SCORE_THRESHOLD=0.18
WORKER_USE_SSD_FALLBACK=false
WORKER_SSD_MIN_CONFIDENCE=0.35
WORKER_FAST_PASS_MODE=true

# Post-filter for false-positive control
WORKER_FILTER_MIN_SCORE=0.12
WORKER_FILTER_MIN_SIDE_PX=12
WORKER_FILTER_MIN_SIDE_RATIO=0.015
WORKER_FILTER_MIN_AREA_RATIO=0.0005
WORKER_FILTER_MAX_AREA_RATIO=0.72
WORKER_FILTER_MIN_ASPECT=0.52
WORKER_FILTER_MAX_ASPECT=1.9

# Confirmation gates
WORKER_CONFIRM_FRAMES=1
WORKER_MIN_CONFIRM_SCORE=0.18
WORKER_MOTION_THRESHOLD=1.5
# Person-in-frame status gate (anti-phantom for UI/logs)
WORKER_PERSON_MIN_SCORE=0.22
WORKER_PERSON_MIN_SIDE_PX=34
WORKER_PERSON_MIN_STREAK=2

# Recognition (match against face registry in DB)
WORKER_ENABLE_MATCHING=true
WORKER_MATCH_THRESHOLD=0.52
# Minimum distance gap between best and second best identity.
# Helps suppress phantom matches on noisy/zoomed frames.
WORKER_MATCH_MIN_MARGIN=0.035
# Minimum detected face side (px) required before identity matching.
WORKER_MATCH_MIN_FACE_SIDE_PX=26
# Extra identity gate: detector confidence required for match/new ID.
WORKER_IDENTITY_MIN_SCORE=0.12
# Identity lock suppresses short label spikes without delaying first recognition.
WORKER_IDENTITY_LOCK_MS=900
WORKER_IDENTITY_LOCK_SWITCH_MARGIN=0.02
# Prevent side/back-body registrations: require frontal face landmarks.
WORKER_REQUIRE_FRONTAL_FACE=true
WORKER_FRONTAL_MIN_EYE_DISTANCE_RATIO=0.22
WORKER_FRONTAL_MAX_EYE_SLOPE=0.14
WORKER_FRONTAL_NOSE_CENTER_TOLERANCE=0.18
WORKER_MATCH_INTERVAL_MS=140
WORKER_MATCH_LOG_COOLDOWN_MS=1000
WORKER_FACE_REGISTRY_ENDPOINT=http://127.0.0.1:3000/api/faces/registry
WORKER_FACE_IDENTIFY_ENDPOINT=http://127.0.0.1:3000/api/faces/identify
WORKER_FACE_REGISTRY_TIMEOUT_MS=2000
WORKER_FACE_IDENTIFY_TIMEOUT_MS=2000
WORKER_FACE_REGISTRY_REFRESH_MS=20000
WORKER_FACE_AUTO_CREATE=true
WORKER_NEW_ID_CONFIRM_FRAMES=1
WORKER_NEW_ID_MIN_SCORE=0.14
WORKER_NEW_ID_MIN_FACE_SIDE_PX=20
WORKER_NEW_ID_EMPTY_MIN_SCORE=0.16
WORKER_NEW_ID_EMPTY_MIN_FACE_SIDE_PX=20
WORKER_NEW_ID_MIN_SHARPNESS=9
WORKER_NEW_ID_EMPTY_MIN_SHARPNESS=11
WORKER_PHANTOM_LOG_ENDPOINT=http://127.0.0.1:3000/api/faces/dedup-logs
WORKER_PHANTOM_LOG_TIMEOUT_MS=1200
WORKER_PHANTOM_SNAPSHOT_DIR=/opt/mood-checker/public/_phantom-rejects
WORKER_PHANTOM_SNAPSHOT_PUBLIC_BASE=/_phantom-rejects

# Emotions (browser-like)
WORKER_ENABLE_EMOTIONS=true
WORKER_EMOTION_INTERVAL_MS=300
WORKER_EMOTION_MIN_CONFIDENCE=0.45
# If top emotion is below strict confidence, worker can still keep it from this floor.
WORKER_EMOTION_LOW_CONFIDENCE_FLOOR=0.18
WORKER_EMOTION_ALLOW_LOW_CONFIDENCE_LABEL=true
WORKER_EMOTION_EMA_ALPHA=0.65
WORKER_EMOTION_EMA_TTL_MS=12000
WORKER_SNAPSHOT_COOLDOWN_MS=300
# Presence-session pipeline (one DB record per person per continuous presence)
WORKER_SESSION_SNAPSHOT_INTERVAL_MS=500
WORKER_SESSION_ABSENCE_MS=2200
WORKER_SESSION_RESOLVE_WAIT_MS=500
WORKER_SESSION_MIN_SAMPLES=1
WORKER_SESSION_MIN_EMOTION_SAMPLES=1
# Clear recognized person from status if face is gone for this long (ms)
WORKER_RECOGNITION_HOLD_MS=2500
# Save last confirmed recognition frame for UI evidence card
WORKER_SAVE_SNAPSHOTS=true
WORKER_SNAPSHOT_SAVE_COOLDOWN_MS=500
WORKER_SNAPSHOT_DIR=/opt/mood-checker/public/_worker-snaps
WORKER_SNAPSHOT_PUBLIC_BASE=/_worker-snaps
WORKER_DB_ENDPOINT=http://127.0.0.1:3000/api/recognitions
WORKER_DB_COOLDOWN_MS=4000
# If recognized person disappeared and reappeared after this gap, send event immediately.
WORKER_DB_REENTRY_GAP_MS=1800
# Fallback mood for DB event when emotion label is weak/empty.
WORKER_DB_ALLOW_MOOD_FALLBACK=true
WORKER_DB_FALLBACK_MOOD=neutral
WORKER_DB_TIMEOUT_MS=1500
WORKER_DB_QUEUE_MAX_SIZE=300
WORKER_DB_QUEUE_BATCH_SIZE=6
WORKER_DB_QUEUE_MAX_ATTEMPTS=4
WORKER_DB_QUEUE_RETRY_BASE_MS=1000
WORKER_DB_QUEUE_WARN_AT=60
