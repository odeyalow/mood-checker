# Node detection worker env (face-api, browser-like)

# Cameras in format: cameraId=go2rtc_src
# Example: cam-01=cam01_main,cam-02=cam02_main
# If empty, worker falls back to NEXT_PUBLIC_CAMERA_1_GO2RTC_SRC..4 from .env.
WORKER_CAMERA_SOURCES=cam-01=cam01_main,cam-02=cam02_main

# Frame API (same endpoint browser uses for snapshot detection)
WORKER_FRAME_API_BASE=http://127.0.0.1:3000/api/camera/frame
WORKER_FRAME_TIMEOUT_MS=1800
WORKER_LOOP_DELAY_MS=80

# Logging/status cadence
WORKER_HEARTBEAT_SECONDS=5
WORKER_STATUS_LOG_SECONDS=1.5
WORKER_STATUS_FILE=/tmp/mood-checker-worker-status.json
WORKER_DETECTION_LOG_COOLDOWN_MS=500
WORKER_CANDIDATE_LOG_COOLDOWN_MS=700

# Detection options (aligned with browser defaults)
WORKER_TINY_INPUT_SIZE=608
WORKER_TINY_SCORE_THRESHOLD=0.24
WORKER_USE_SSD_FALLBACK=true
WORKER_SSD_MIN_CONFIDENCE=0.35

# Confirmation gates
WORKER_CONFIRM_FRAMES=2
WORKER_MIN_CONFIRM_SCORE=0.32
WORKER_MOTION_THRESHOLD=1.5

