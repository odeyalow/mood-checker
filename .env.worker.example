# Python detection worker env
#
# Comma-separated RTSP URLs for worker input.
# If empty, worker falls back to NEXT_PUBLIC_CAMERA_1_RTSP_URL..4 from .env.
WORKER_RTSP_URLS=rtsp://127.0.0.1:8554/cam01_main

# Detector config
WORKER_DETECTOR=insightface
WORKER_MODEL_NAME=buffalo_l
WORKER_DET_SIZE=960
WORKER_HAAR_FALLBACK=true

# Runtime tuning
WORKER_FRAME_STRIDE=1
WORKER_MAX_WIDTH=1280
WORKER_HEARTBEAT_SECONDS=5
WORKER_RECONNECT_DELAY_SECONDS=1.5
WORKER_DETECTION_LOG_COOLDOWN_SECONDS=0.5
WORKER_CANDIDATE_LOG_COOLDOWN_SECONDS=0.6
WORKER_GRAB_FLUSH=1
WORKER_CONFIRM_FRAMES=2
WORKER_MIN_CONFIRM_SCORE=0.34
WORKER_MOTION_THRESHOLD=1.3
WORKER_TRACK_IOU_THRESHOLD=0.08
WORKER_STATUS_LOG_SECONDS=1.5
WORKER_STATUS_FILE=/tmp/mood-checker-worker-status.json

# False-positive filtering
WORKER_DET_MIN_SCORE=0.35
WORKER_DET_MIN_SIDE_RATIO=0.02
WORKER_DET_MAX_SIDE_RATIO=0.82
WORKER_DET_MIN_ASPECT=0.62
WORKER_DET_MAX_ASPECT=1.62
