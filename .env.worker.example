# Python detection worker env
#
# Comma-separated RTSP URLs for worker input.
# If empty, worker falls back to NEXT_PUBLIC_CAMERA_1_RTSP_URL..4 from .env.
WORKER_RTSP_URLS=rtsp://127.0.0.1:8554/cam01_main

# Detector config
WORKER_DETECTOR=insightface
WORKER_MODEL_NAME=buffalo_l
WORKER_DET_SIZE=960

# Runtime tuning
WORKER_FRAME_STRIDE=1
WORKER_MAX_WIDTH=1280
WORKER_HEARTBEAT_SECONDS=5
WORKER_RECONNECT_DELAY_SECONDS=1.5
WORKER_DETECTION_LOG_COOLDOWN_SECONDS=0.5
