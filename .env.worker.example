# Node detection worker env (InsightFace backend + worker status UI)

# Cameras in format: cameraId=go2rtc_src
# Example: cam-01=cam01_main
# If empty, worker falls back to NEXT_PUBLIC_CAMERA_1_GO2RTC_SRC..4 from .env.
WORKER_CAMERA_SOURCES=cam-01=cam01_main

# Worker frame API override. If empty, worker derives a direct go2rtc frame URL
# from GO2RTC_BASE_URL + GO2RTC_FRAME_WIDTH/HEIGHT/QUALITY in .env.
# Example override:
# http://127.0.0.1:1984/api/frame.jpeg?width=960&height=540&quality=82
# Leave empty to pull straight from go2rtc, built from GO2RTC_BASE_URL and
# GO2RTC_FRAME_WIDTH/HEIGHT/QUALITY. Set it only to read frames from somewhere
# else (for example the Next.js proxy at /api/camera/frame).
# How frames are obtained.
#   snapshot - one HTTP request per frame (default). Each costs a decode plus a
#              wait for the next keyframe: measured 623-711 ms on an H265 camera,
#              about 3 frames for a 2 s walk-past.
#   mjpeg    - hold one connection open and serve the newest frame from memory.
#              Measured 25 fps on the same camera.
# H265 sources cannot produce MJPEG directly, so point WORKER_MJPEG_URL at a
# transcoded stream (see cam01_mjpeg in go2rtc.yaml) rather than the raw one.
# Falls back to a snapshot request whenever the stream is down or its newest
# frame is older than WORKER_MJPEG_STALE_MS, so a reconnect never stops detection.
WORKER_FRAME_MODE=snapshot
WORKER_MJPEG_URL=
WORKER_MJPEG_STALE_MS=2000

WORKER_FRAME_API_BASE=
WORKER_FRAME_TIMEOUT_MS=3000
# Retry once with lighter frame settings when frame request hits AbortError timeout
WORKER_FRAME_ABORT_RETRY_ENABLED=true
WORKER_FRAME_ABORT_RETRY_TIMEOUT_MS=5200
WORKER_IMAGE_DECODE_TIMEOUT_MS=1500
WORKER_CAMERA_PROCESS_TIMEOUT_MS=7000
WORKER_FRAME_ABORT_RETRY_WIDTH=1280
WORKER_FRAME_ABORT_RETRY_HEIGHT=720
WORKER_FRAME_ABORT_RETRY_QUALITY=82
# Cameras processing parallelism (1..N cameras)
WORKER_PARALLEL_CAMERAS=1
WORKER_LOOP_DELAY_MS=50

# Logging/status cadence
WORKER_HEARTBEAT_SECONDS=5
WORKER_STATUS_LOG_SECONDS=1.5
WORKER_STATUS_FILE=/tmp/mood-checker-worker-status.json
WORKER_ZOOM_STATE_FILE=/tmp/mood-checker-worker-zoom.json
WORKER_ZOOM_RELOAD_MS=700
# Per-camera worker zoom defaults (x1..x5), optional.
# If empty, worker inherits NEXT_PUBLIC_CAMERA_1_DIGITAL_ZOOM..4 from .env.
# Example: cam-01=2
WORKER_CAMERA_ZOOMS=cam-01=1
# Optional per-camera thresholds as JSON.
# Example:
# {"cam-01":{"matchThreshold":0.56,"matchMinMargin":0.04,"frameOffsetY":0.18}}
WORKER_CAMERA_SETTINGS_JSON=
WORKER_DETECTION_LOG_COOLDOWN_MS=500
WORKER_CANDIDATE_LOG_COOLDOWN_MS=700

# Detection options (fast-pass defaults)
WORKER_INFERENCE_BACKEND=auto
WORKER_INFERENCE_FALLBACK_FACEAPI=true
WORKER_INSIGHTFACE_ENDPOINT=http://127.0.0.1:8765
WORKER_INSIGHTFACE_PORT=8765
WORKER_INSIGHTFACE_TIMEOUT_MS=2500
# First run downloads the ~280 MB model pack before the service answers /health,
# so this has to cover a slow link. Once the models are cached startup is instant.
WORKER_INSIGHTFACE_STARTUP_TIMEOUT_MS=300000
# Pin the interpreter instead of letting the worker guess. Without it the order is
# .venv, then "python", then "python3" — and on Debian "python" does not exist
# while "python3" is the system one with none of the dependencies installed.
WORKER_PYTHON_BIN=/opt/mood-checker/.venv/bin/python
WORKER_INSIGHTFACE_MODEL=buffalo_l
# Optional explicit python binary. If empty, worker tries local .venv first, then python/python3 from PATH.
WORKER_PYTHON_BIN=
# Detection confidence floor inside InsightFace itself (SCRFD). Was implicitly 0.5.
WORKER_INSIGHTFACE_DET_THRESH=0.5
# SCRFD input resolution. 960 detects smaller/further faces; 640 is roughly 2x
# cheaper on CPU and is usually plenty for a person walking past a single camera.
# Lower this first if you need latency.
WORKER_INSIGHTFACE_DET_SIZE=960
# ONNX threads for detection/recognition/emotions; 0 = every core. The
# service runs niced (WORKER_PYTHON_NICE) so that under contention it yields to
# the ffmpeg H265 decode that feeds it — a starved decoder means dropped and
# half-decoded (dark) frames, which no threshold can fix. Lower the thread
# count only if the box still drops frames with the nice in place.
WORKER_ONNX_INTRA_THREADS=0
# ONNX Runtime keeps its threads spinning after each op waiting for more work;
# on a box that also decodes video in real time that steals cycles from ffmpeg
# between detections. Off unless measured otherwise.
WORKER_ONNX_ALLOW_SPINNING=0
# nice value for the Python service, 0-19 (higher yields more; 0 = off).
WORKER_PYTHON_NICE=5
# The service logs "analyze n=.. per_s=.. decode_ms .. run_ms .." at this
# interval: the real throughput and where each call spends its time.
WORKER_ANALYZE_TIMING_LOG_S=10

# --- Emotions (HSEmotion, runs inside the InsightFace service) ---------------
# hsemotion = EfficientNet-B0 trained on AffectNet, classified directly on the
# already-detected face box (~10 ms/face on CPU). "none" disables it and falls
# back to the old face-api expression path.
WORKER_EMOTION_BACKEND=hsemotion
# Defaults to worker/models/enet_b0_8_best_afew.onnx.
# Fetch it with: node scripts/download-emotion-model.mjs
WORKER_EMOTION_MODEL_PATH=
WORKER_EMOTION_PROVIDERS=CPUExecutionProvider
# Padding around the face box before the 224x224 crop, as a fraction of box size.
WORKER_EMOTION_CROP_MARGIN=0.1
# The model has EIGHT classes; the UI has seven. Contempt used to share the
# "disgusted" key with Disgust, making it the only key fed by two classes — an
# advantage no other key has, and Contempt is what a downward-looking camera
# reads off slightly pressed lips.
#
# Measured on this camera while holding known expressions: a smile logged
# Happiness 0.24-0.28 but Contempt 0.22-0.36 on top of Disgust 0.15-0.21, so
# the shared key won and EVERY smile recorded as "disgusted". Across 15 frames
# of known expressions, sharing matched 7; dropping Contempt matched 15 and
# left anger and sadness untouched. Hence "drop" by default. Replay those
# readings with `npm run test:emotion:mapping`.
#
# Set to "disgusted" or "neutral" to fold it back in. WORKER_EMOTION_RAW_DEBUG
# logs the raw eight ("emotion_raw8 Anger=.. Contempt=..") to re-measure.
# Level the eyes before classifying. The model was trained on upright faces; a
# camera mounted high and angled down delivers them tilted, and a plain
# rectangular crop passes that tilt to the classifier, which shows up as a
# smeared low-confidence distribution instead of a clean winner. Costs one
# small warpAffine (~0.2 ms) and replaces the crop, so nothing is resampled
# twice. Rotation is skipped below MIN_DEG (not worth it) and above MAX_DEG
# (a detection artefact, not a tilted head). EYE_LINE places the eye line in
# the crop: 0.8 leaves room for the mouth, which carries most of a smile.
WORKER_EMOTION_ALIGN=true
WORKER_EMOTION_ALIGN_MIN_DEG=3
WORKER_EMOTION_ALIGN_MAX_DEG=45
WORKER_EMOTION_ALIGN_EYE_LINE=0.8
WORKER_EMOTION_CONTEMPT_MAP=drop
WORKER_EMOTION_RAW_DEBUG=0
WORKER_EMOTION_RAW_LOG_S=1
# onnxruntime intra-op threads for the emotion model. 0 = let onnxruntime decide.
WORKER_ONNX_INTRA_THREADS=0
WORKER_TINY_INPUT_SIZE=512
WORKER_TINY_SCORE_THRESHOLD=0.18
WORKER_USE_SSD_FALLBACK=false
WORKER_SSD_MIN_CONFIDENCE=0.35
WORKER_FAST_PASS_MODE=true

# Post-filter for false-positive control.
# Values below are the 2-4 m preset. For a 1-3 m camera at 1920x1080 use:
#   MIN_SCORE=0.40  MIN_SIDE_PX=32  MIN_SIDE_RATIO=0.03
#   MIN_AREA_RATIO=0.0006  MAX_AREA_RATIO=0.25
# MIN_SIDE_PX is checked against BOTH sides of the box, so the face WIDTH binds.
WORKER_FILTER_MIN_SCORE=0.09
WORKER_FILTER_MIN_SIDE_PX=12
WORKER_FILTER_MIN_SIDE_RATIO=0.015
WORKER_FILTER_MIN_AREA_RATIO=0.0005
WORKER_FILTER_MAX_AREA_RATIO=0.72
WORKER_FILTER_MIN_ASPECT=0.52
WORKER_FILTER_MAX_ASPECT=1.9

# Confirmation gates
WORKER_CONFIRM_FRAMES=1
WORKER_MIN_CONFIRM_SCORE=0.12
WORKER_MOTION_THRESHOLD=1.5
# Person-in-frame status gate (anti-phantom for UI/logs)
WORKER_PERSON_MIN_SCORE=0.16
# Compared against max(width, height) of the box — the face HEIGHT. 1-3 m: 48.
# Note the lens: a 110-degree wide-angle sees a face at 3 m as ~36px wide where a
# 90-degree lens sees ~51px. Gates copied from a narrower camera will silently
# reject most of the room.
WORKER_PERSON_MIN_SIDE_PX=20
WORKER_PERSON_MIN_STREAK=1

# Recognition (match against face registry in DB)
WORKER_ENABLE_MATCHING=true
# Cosine distance below which a face is the stored identity. Measured on this
# camera (npm run faces:report): the same person across passes sits at
# 0.3-0.5 with good crops and up to ~0.65 with pose/distance changes; different
# people sit at 0.8-1.0. 0.56 was tuned for a 1700-face registry where every
# extra 0.01 adds wrong matches; on a registry of dozens to a few hundred
# 0.62 recovers the same-person-different-pose passes and still leaves ~0.2
# to the nearest stranger. Templates only grow from matches (see
# FACE_IDENTITY_UPDATE_MAX_DISTANCE), so a threshold too tight for a fresh
# single-vector identity keeps it fragile forever.
WORKER_MATCH_THRESHOLD=0.56
# Minimum distance gap between best and second best identity.
# Helps suppress phantom matches on noisy/zoomed frames.
WORKER_MATCH_MIN_MARGIN=0.04
# Minimum detected face side (px) required before identity matching.
# Smallest face that may be MATCHED against the registry. Compared against
# max(width, height).
#
# Keep this BELOW WORKER_NEW_ID_MIN_FACE_SIDE_PX. The two jobs need different
# strictness: creating an identity from a poor crop poisons it permanently, while
# matching only has to find the nearest neighbour among vectors that are already
# good — and with multi-descriptor templates it gets several tries. Equal
# thresholds throw away recognitions that would have worked, which shows up as
# "the face is detected but it does not know who it is".
#
# Calibrate with WORKER_POSE_DEBUG=1: stand at the far edge of the range you want
# recognised, read "side=" from the log, set this just below it.
WORKER_MATCH_MIN_FACE_SIDE_PX=16
# Extra identity gate: detector confidence required for match/new ID.
WORKER_IDENTITY_MIN_SCORE=0.12
# Identity lock suppresses short label spikes without delaying first recognition.
WORKER_IDENTITY_LOCK_MS=900
WORKER_IDENTITY_LOCK_SWITCH_MARGIN=0.02
# Prevent side/back-body registrations: require frontal face landmarks.
WORKER_REQUIRE_FRONTAL_FACE=true
WORKER_FRONTAL_MIN_EYE_DISTANCE_RATIO=0.22
WORKER_FRONTAL_MAX_EYE_SLOPE=0.14
WORKER_FRONTAL_NOSE_CENTER_TOLERANCE=0.18
# OPTIONAL pose gate for DB writes (recognition + new IDs), independent of the
# display flag above. OFF by default on purpose: on high-mounted / distant cameras
# the landmarks of small faces are noisy, so enabling it without tuning rejects
# normal faces too and nothing gets recorded. Enable ONLY after reading real values
# with WORKER_POSE_DEBUG=1 and setting the thresholds below to match your camera.
WORKER_RECORD_REQUIRE_FRONTAL=false
# How far the nose may turn from centre before it counts as a profile (higher = looser).
WORKER_RECORD_POSE_MAX_YAW=0.36
# Min mouth-below-nose distance (share of face height) before a top-down view is rejected
# (higher = stricter against top-down; lower = more permissive). On cameras mounted high
# this metric barely separates good vs top-down faces — keep it low (~0.03) there.
WORKER_RECORD_POSE_MIN_MOUTH_DROP=0.05
# Alternative top-down gate by eye-line height (works better on high-mounted cameras).
# 1 = disabled (default). Lower it (e.g. 0.55) to reject faces whose eyes sit too low in
# the box. Use WORKER_POSE_DEBUG=1 to read real eyeLineY values, then pick a value just
# above the normal-face eyeLineY.
WORKER_RECORD_POSE_MAX_EYELINE=1
# Profile gate: minimum eye separation (share of face width). Rejects side/profile faces
# ("чисто справа/слева"). Robust to distance & height. Higher = stricter (0.18 default;
# raise toward 0.24 to also reject moderate turns; lower if it drops normal faces).
WORKER_RECORD_POSE_MIN_EYE_DIST=0.18
WORKER_MATCH_INTERVAL_MS=140
WORKER_MATCH_LOG_COOLDOWN_MS=1000
WORKER_FACE_REGISTRY_ENDPOINT=http://127.0.0.1:3000/api/faces/registry
WORKER_FACE_IDENTIFY_ENDPOINT=http://127.0.0.1:3000/api/faces/identify
WORKER_FACE_REGISTRY_TIMEOUT_MS=2000
WORKER_FACE_IDENTIFY_TIMEOUT_MS=2000
WORKER_FACE_REGISTRY_REFRESH_MS=20000
WORKER_IDENTIFY_MIN_INTERVAL_MS=900
WORKER_AUTO_CREATE_COOLDOWN_MS=2200
WORKER_FACE_AUTO_CREATE=true
# Frames in a row (within WORKER_NEW_ID_MAX_GAP_MS) a face must clear the gate
# below before it may be ENROLLED. With identities in the registry the worker
# uses at least 2 whatever this says. Only enrolment waits for this; matching an
# existing identity never does (the identify request carries allowCreate=false
# until the gate is cleared).
WORKER_NEW_ID_CONFIRM_FRAMES=1
# true: the first frame that clears the soft gate may enrol (the original
# behaviour — a walking person is enrolled on the pass they are seen on).
# false: enrolment waits for CONFIRM_FRAMES stable frames; fewer false
# enrolments, but at walking pace it often waits the person out of frame.
# A wrong enrolment is one "Block" click on the Faces page; a missed one is
# invisible. Keep true unless the registry fills with non-faces.
WORKER_NEW_ID_SOFT_CREATE=true
# Detector score a face needs to be ENROLLED. The Python service already drops
# anything under det_thresh 0.5, so the old 0.14 was a no-op. A real frontal
# face 40 px and up scores ~0.75-0.9 on SCRFD; the back of a head, a cap or a
# poster that slips through detection tends to sit at 0.5-0.65. Every enrolment
# is logged as "new_id created ... score=X side=Y sharp=Z" — read those before
# tightening further, and "new_id blocked" lines (WORKER_NEW_ID_DEBUG=1) show
# what a stricter value rejects. A too-strict value only delays enrolment to a
# better frame; a too-loose one fills the registry with non-faces that must be
# blocked by hand.
# Detector confidence required to ENROL a new identity. Measured on this camera:
# a real frontal face at conversational distance scores 0.78-0.88, while the
# detections that turn out to be ears, the back of a head, or a face far across
# the room sit at 0.51-0.70. A threshold inside that band lets those become
# identities — one such row collected mostly ears from several different people
# and then kept matching strangers onto itself. Recognition is NOT affected.
WORKER_NEW_ID_MIN_SCORE=0.72
# Smallest face an identity may be CREATED from. Keep it ABOVE
# WORKER_MATCH_MIN_FACE_SIDE_PX: a bad crop used here poisons the identity
# permanently, while a bad crop used for matching costs nothing.
#
# But it must stay REACHABLE. On an empty registry nothing can be matched until
# something is enrolled, so a gate set above what the camera actually delivers
# leaves every face as "unknown" forever. The worker logs "new_id blocked ..."
# with the real numbers whenever the registry is empty — read that before
# choosing a value.
WORKER_NEW_ID_MIN_FACE_SIDE_PX=20
WORKER_NEW_ID_EMPTY_MIN_SCORE=0.16
WORKER_NEW_ID_EMPTY_MIN_FACE_SIDE_PX=20
WORKER_NEW_ID_MIN_SHARPNESS=9
# Minimum frame quality before a face may become an IDENTITY, on the same
# score x size x sharpness scale the reference frame is chosen by (halved for a
# non-frontal face). The per-metric gates above are checked independently, so a
# face can pass them all while being unusable: the soft path alone accepts
# 40 px at sharpness 2.5, which is a smear from across the room — exactly what
# fills a registry with barely-visible heads after a few days.
#
# Scored against real logged frames: distant smear 0.04, entering the zone
# 0.09, mid-approach 0.27, walking past the camera 0.57, standing at it 0.87.
# 0.15 sits in the empty band between the smears and the usable frames. Raise
# it if junk identities still appear, lower it if real people stop being
# enrolled; every enrolment logs "new_id created ... quality=" and every
# rejection "new_id blocked quality=", so both directions are measurable.
# Matching is NOT affected — a known face is still recognised from a poor frame.
WORKER_NEW_ID_MIN_QUALITY=0.15
WORKER_NEW_ID_EMPTY_MIN_SHARPNESS=11
WORKER_PHANTOM_LOG_ENDPOINT=http://127.0.0.1:3000/api/faces/dedup-logs
WORKER_PHANTOM_LOG_TIMEOUT_MS=1200
WORKER_PHANTOM_SNAPSHOT_DIR=/opt/mood-checker/public/_phantom-rejects
WORKER_PHANTOM_SNAPSHOT_PUBLIC_BASE=/_phantom-rejects

# Emotions (browser-like)
WORKER_ENABLE_EMOTIONS=true
WORKER_EMOTION_INTERVAL_MS=300
WORKER_EMOTION_MIN_CONFIDENCE=0.14
# If top emotion is below strict confidence, worker can still keep it from this floor.
WORKER_EMOTION_LOW_CONFIDENCE_FLOOR=0.06
WORKER_EMOTION_ALLOW_LOW_CONFIDENCE_LABEL=true
# Emotion strictness: 0 = expressive (legacy, more non-neutral labels),
# 1 = strict (favours neutral, fewer unrealistic emotions). 0.5 is a balanced default.
# 0 = the old face-api-era behaviour: discount neutral, boost every expressive
# class, and promote a runner-up over neutral. HSEmotion is well calibrated and
# needs none of that — with 0.5 a face the model scored Neutral 0.58 was stored
# as "angry". Use 1 with the HSEmotion backend.
# Report the emotion model's own winner instead of reshaping its output.
#
# Everything WORKER_EMOTION_STRICTNESS controls was written for face-api, whose
# expression outputs needed correcting. HSEmotion returns a calibrated softmax,
# and those corrections then bias it: neutral is discounted and a runner-up is
# promoted over neutral once it reaches 60-80% of it — always true on a mildly
# expressive face. Measured on this camera: a resting face reading neutral 0.52
# came out as "sad", and a live session produced sad/angry/disgusted for every
# record while neutral, happy and surprised never won one.
#
# Defaults to true whenever WORKER_EMOTION_BACKEND is hsemotion; the heuristic
# stays for the face-api fallback it was built for. `npm run test:emotion`
# prints both paths side by side.
WORKER_EMOTION_TRUST_MODEL=true
WORKER_EMOTION_STRICTNESS=0.5

# Write another row when the mood changes while the person stays in frame,
# instead of only one row per visit. The new label must hold for
# WORKER_EMOTION_CHANGE_MIN_MS and clear the confidence floor before it counts;
# WORKER_DB_COOLDOWN_MS still applies, so rows stay at least that far apart.
WORKER_EMOTION_CHANGE_RECORD=true
WORKER_EMOTION_CHANGE_MIN_MS=1200
# A visit is often recorded on the frame the person is registered on, before a
# single emotion reading exists, and the row then says WORKER_DB_FALLBACK_MOOD
# ("neutral") for a face that was never read. When the first real reading
# arrives within this window, it replaces that row instead of waiting out
# WORKER_EMOTION_CHANGE_MIN_MS, which a 2-second walk-past never reaches.
# Keep it BELOW the API's RECOGNITION_DEDUP_MS (1800), or the upgrade lands as
# a second row instead of replacing the first. 0 disables it.
WORKER_EMOTION_UPGRADE_MAX_MS=1500
# What counts as a full-quality reference frame for an identity. The worker
# scores every frame of a visit as score x size x sharpness (halved for a
# non-frontal face) and sends the BEST one with the visit's record; the API
# promotes it to the identity's primary vector when it clearly beats the frame
# that identity was enrolled from (FACE_PRIMARY_PROMOTE_MIN_GAIN, default 0.08,
# and only on a match closer than FACE_PRIMARY_PROMOTE_MAX_DISTANCE, 0.5 — both
# read from .env by the app).
#
# These two are goals, not gates: a face at them scores 1.0, half the size or
# half the sharpness halves the score, and nothing is ever rejected for missing
# them. Check them against real "record name=... side=... sharp=..." lines —
# set them near what a good frontal frame at your camera actually reaches.
# Run `npm run test:enrolment` to see how the rules behave on sample frames.
# Whether a face must pass the frontal/pose check before it may be MATCHED
# against known identities. Separate from enrolment on purpose: recognising
# someone already on file survives a turned head, and a bad angle is rejected
# by match distance anyway, while creating a NEW identity from a bad angle
# poisons the registry — that always keeps the full check.
#
# Measured on this camera: a walking person yields yawOff 0.40-0.90. The pose
# gate cannot even express a threshold that high (it clamps at 0.49), because
# the metric divides by the eye span, which a downward-looking camera squeezes.
# So with this on, walk-pasts were refused before matching was attempted.
# Turn it on only if strangers start matching onto the wrong identity.
WORKER_MATCH_REQUIRE_FRONTAL=false
WORKER_ENROLL_TARGET_SIDE_PX=110
WORKER_ENROLL_TARGET_SHARPNESS=16
WORKER_EMOTION_CHANGE_MIN_CONFIDENCE=0.35
WORKER_EMOTION_EMA_ALPHA=0.45
# How a visit's emotion label is chosen from its frames.
# PEAK_WEIGHT 0 ignores a label's single best frame; the old 0.25 let one frame
# read as "sad" at 0.99 outrank four "neutral" frames at 0.5.
# VOTE_WEIGHT 1 ranks labels by the share of frames they won, which is what makes
# a misread frame harmless while a real mood (present in most frames) still wins.
WORKER_EMOTION_PEAK_WEIGHT=0
# The window averages the full per-frame distributions, which already resists a
# single bad frame AND keeps near-ties visible. Counting argmax winners instead
# (VOTE_WEIGHT > 0) destroys ties, so pairing stops working.
WORKER_EMOTION_VOTE_WEIGHT=0
# Report a near-tie between two compatible emotions as "sad+neutral". Gap in
# points on a 0-100 scale between the top two; 0 disables it.
# Measured: at 20 a real tie (sad 46 / neutral 44) pairs and clear reads stay
# single; at 50 even neutral 58 vs angry 22 would pair, which is not a tie.
# Only emotions that can share a face pair up — happy+sad never merges.
WORKER_EMOTION_PAIR_MAX_GAP=50
# ...and the pair must lead the THIRD emotion by this much. Both conditions
# together mean "these two stand out together": without the lead check a flat
# read (30/28/26) pairs its first two arbitrarily, and a lone winner over a
# spread field (58/22/16) pairs too.
WORKER_EMOTION_PAIR_MIN_LEAD=12
# The label is computed over this rolling window of recent frames. It is what
# keeps a single misread frame from flipping the mood, while still letting a real
# change take over once it fills most of the window (~900 ms in practice).
# Do NOT clear this window after writing a row: doing so leaves the next frame as
# the only sample, share 1.0, and one bad frame writes a wrong row immediately.
WORKER_EMOTION_WINDOW_MS=2500
# Per-person calibration: multipliers applied to the emotion scores before the
# label is chosen, e.g. "neutral=1.2" or "neutral=1.3,sad=0.85". Emotion models
# carry a face-specific offset — a resting face can read as mildly sad — and no
# amount of smoothing fixes it because every frame agrees. Measure the value with
# `npm run calibrate:emotion` while holding a neutral face; do not guess.
WORKER_EMOTION_CLASS_BIAS=
WORKER_EMOTION_EMA_TTL_MS=12000
WORKER_SNAPSHOT_COOLDOWN_MS=300
# Presence-session pipeline (one DB record per person per continuous presence)
WORKER_SESSION_SNAPSHOT_INTERVAL_MS=300
WORKER_SESSION_ABSENCE_MS=3300
WORKER_SESSION_RESOLVE_WAIT_MS=300
WORKER_SESSION_MIN_SAMPLES=1
WORKER_SESSION_MIN_EMOTION_SAMPLES=1
# Clear recognized person from status if face is gone for this long (ms)
WORKER_RECOGNITION_HOLD_MS=1800
# Save last confirmed recognition frame for UI evidence card
WORKER_SAVE_SNAPSHOTS=true
WORKER_SNAPSHOT_SAVE_COOLDOWN_MS=500
WORKER_SNAPSHOT_DIR=/opt/mood-checker/public/_worker-snaps
WORKER_SNAPSHOT_PUBLIC_BASE=/_worker-snaps
# Per-person face crops, written to public/_faces/<id>/; the Faces page and
# each DB record point at the newest one. Cut from the decoded source frame at
# native resolution, so their quality is the camera stream's (see the -q:v
# note in go2rtc.yaml), not a re-encode. One crop per person per cooldown,
# only when the crop clears WORKER_RECORD_MIN_FACE_SIDE_PX and
# WORKER_RECORD_MIN_SHARPNESS; older files are pruned past MAX_PER_FACE.
WORKER_FACE_ARCHIVE_ENABLED=true
WORKER_FACE_ARCHIVE_COOLDOWN_MS=2500
# Keep the BEST frames of a visit, not every frame that clears the cooldown.
# Someone standing in view produced a picture every few seconds, so a gallery
# filled with near-identical crops and the good one was buried among them.
# After the first picture of a visit, a later one is kept only if it beats the
# best so far by this much on the quality scale (score x size x sharpness).
# 0 restores the old behaviour of keeping every frame. The frames that are NOT
# kept still do their job: they feed the identity's reference vector.
WORKER_FACE_ARCHIVE_MIN_QUALITY_GAIN=0.05
WORKER_FACE_ARCHIVE_MAX_PER_FACE=50
# Debug picture of what the worker sees (zoom window applied), written to
# public/_worker-live/<cam>.jpg. Nothing in the UI reads it, so it is off.
# Enabled, it used to write the full 2560x1440 frame on every pass (~600 KB,
# 1.5-2.3 MB/s of disk writes, 40-60 ms of CPU per pass); now it is rate
# limited and downscaled.
WORKER_PREVIEW_ENABLED=false
WORKER_PREVIEW_INTERVAL_MS=1000
WORKER_PREVIEW_MAX_WIDTH=960
WORKER_PREVIEW_QUALITY=0.82
# The one reason to turn the preview ON: the dashboard tile can show it
# instead of asking go2rtc for a second H265->MJPEG transcode
# (NEXT_PUBLIC_CAMERA_PREVIEW_MODE=worker in .env, rebuild the app). Then use
# WORKER_PREVIEW_INTERVAL_MS=250 and put the file in RAM — set this in .env,
# which both the app and the worker read:
#   WORKER_PREVIEW_DIR=/dev/shm/mood-checker-live
WORKER_DB_ENDPOINT=http://127.0.0.1:3000/api/recognitions
WORKER_DB_COOLDOWN_MS=2000
# If recognized person disappeared and reappeared after this gap, send event immediately.
WORKER_DB_REENTRY_GAP_MS=800
# Fallback mood for DB event when emotion label is weak/empty.
WORKER_DB_ALLOW_MOOD_FALLBACK=true
WORKER_DB_FALLBACK_MOOD=neutral
WORKER_DB_TIMEOUT_MS=1500
WORKER_DB_QUEUE_MAX_SIZE=300
WORKER_DB_QUEUE_BATCH_SIZE=6
WORKER_DB_QUEUE_MAX_ATTEMPTS=4
WORKER_DB_QUEUE_RETRY_BASE_MS=1000
WORKER_DB_QUEUE_WARN_AT=60
# DB writer mode:
# - inline: detection worker writes directly to /api/recognitions (legacy)
# - external: detection worker appends jobs to JSONL queue, separate consumer writes to DB
WORKER_DB_WRITER_MODE=external
WORKER_DB_QUEUE_FILE=/opt/mood-checker/worker/recognition-queue.jsonl
WORKER_DB_QUEUE_CURSOR_FILE=/opt/mood-checker/worker/recognition-queue.cursor
WORKER_DB_QUEUE_CONSUMER_POLL_MS=220
WORKER_DB_QUEUE_COMPACT_AT_BYTES=1048576

# Reconnect when an open MJPEG connection goes silent for this long. go2rtc
# starts its transcoder on demand and leaves the HTTP response open when it
# dies, so the stream can stop without ever closing — the reader would then wait
# on a healthy-looking socket while every pass fell back to a slow one-shot
# frame. At 12 fps a live stream never pauses for seconds. `npm run test:mjpeg`
# covers both the silent and the healthy case.
WORKER_MJPEG_SILENCE_MS=4000
