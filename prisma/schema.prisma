generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Recognition {
  id                String   @id @default(cuid())
  name              String
  mood              String
  detectedAt        DateTime @default(now())
  cameraId          String?
  distance          Float?
  emotionConfidence Float?
  workerZoom        Float?
  frameWidth        Int?
  frameHeight       Int?
  snapshotUrl       String?
  faceIdentityId    String?
  faceIdentity      FaceIdentity? @relation(fields: [faceIdentityId], references: [id], onDelete: SetNull)

  @@index([detectedAt])
  @@index([cameraId, detectedAt])
  @@index([faceIdentityId, detectedAt])
}

model FaceIdentity {
  id         String        @id @default(cuid())
  shortId    String        @unique
  descriptor Json
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  recognitions Recognition[]

  @@index([createdAt])
}

model FaceDedupLog {
  id                String   @id @default(cuid())
  action            String
  reason            String
  sourceFaceId      String?
  sourceShortId     String?
  sourceSnapshotUrl String?
  targetFaceId      String?
  targetShortId     String?
  targetSnapshotUrl String?
  distance          Float?
  threshold         Float?
  createdAt         DateTime @default(now())

  @@index([createdAt])
}

model EmotionSnapshot {
  id            String   @id @default(cuid())
  bucketStart   DateTime @unique
  totalStudents Int
  positiveCount Int
  neutralCount  Int
  negativeCount Int
  students      Json
  recognitions  Json
  createdAt     DateTime @default(now())
}
